# Copy to .env in this directory for agent-level secrets.
# Loaded after the repo-root .env (see main.py); values here override when both exist.
#
# Alternatively, run from the repo root and keep OPENAI_* in the root .env only.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: persist reviews outside the package tree
# DATA_DIR=/var/lib/feedback-agent/data

# Optional: public links (no trailing slash) for share URLs and job review_url
# PUBLIC_BASE_URL=https://feedback.example.com

# Used only when PUBLIC_BASE_URL is unset (job payload review_url)
# HOST=127.0.0.1
# PORT=5055
