# Copy to app/pose_api/.env on the RunPod pod (or export in the shell).
# Loaded by pose_api/main.py after repo-root / agents .env files.
#
# RunPod: use system Python (CUDA torch preinstalled) — fast setup, no venv:
#   POSE_API_USE_SYSTEM_PYTHON=1
#   bash scripts/run-pose-api.sh

# GPU inference (RunPod PyTorch pod)
YOLO_POSE_DEVICE=cuda
YOLO_POSE_WEIGHTS=yolov8n-pose.pt
YOLO_HIGHLIGHT_WEIGHTS=app/yolo_model/artifacts/train/highlight_v1.1.0/weights/best.pt

# Job storage (use a persistent volume path on RunPod, e.g. /workspace/data)
DATA_DIR=/workspace/agentic/data/pose_api
POSE_PIPELINE_OUTPUT_DIR=/workspace/agentic/data/pose

# HTTP server
HOST=0.0.0.0
PORT=5060

# Optional: require Authorization: Bearer <key> on all /pose/* routes
# POSE_API_KEY=

# Public URL for docs only (client uses POSE_API_BASE_URL on the main VM)
# POSE_API_PUBLIC_BASE_URL=https://xxxxx-5060.proxy.runpod.net
