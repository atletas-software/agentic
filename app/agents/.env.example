# Copy to .env in this directory for agent-level secrets.
# Loaded after the repo-root .env (see main.py); values here override when both exist.
#
# Alternatively, run from the repo root and keep OPENAI_* in the root .env only.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: persist reviews outside the package tree
# DATA_DIR=/var/lib/feedback-agent/data

# Public base URL (no trailing slash) used to build share URLs and the job's review_url.
# REQUIRED on any deployed server — otherwise the agent falls back to http://HOST:PORT
# (defaults to 127.0.0.1:5055) and the links won't open in the user's browser.
#   Same-server deploy:        http://<your-server-host>:5055
#   Behind reverse proxy (TLS): https://feedback.yourdomain.com
# Set PUBLIC_BASE_URL here for Docker (e.g. https://feedback.yourdomain.com or http://VM_IP:5055).
# PUBLIC_BASE_URL=

# Used only when PUBLIC_BASE_URL is unset (local dev fallback for review_url).
# HOST=127.0.0.1
# PORT=5055
