# Copy to .env in this directory for agent-level secrets.
# Loaded after the repo-root .env (see main.py); values here override when both exist.
#
# Alternatively, run from the repo root and keep OPENAI_* in the root .env only.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: persist reviews outside the package tree
# DATA_DIR=/var/lib/feedback-agent/data

# Next.js origin where users open reviews and share links (no trailing slash).
# The frontend proxies /review, /jobs, /share to the API — do not use :8000 or :5055 here.
#   Local:  http://localhost:3000
#   GCP:    http://YOUR_VM_IP:3000
# FRONTEND_BASE_URL=https://connect.athlete-focus.com
#
# Fallback public origin for image/status URLs if FRONTEND_BASE_URL is unset.
# PUBLIC_BASE_URL=

# Used only when PUBLIC_BASE_URL is unset (local dev fallback for review_url).
# HOST=127.0.0.1
# PORT=5055

# ---- YOLO pose pipeline (feedback-agent container; CPU by default) ----
# Leave unset in Docker — image bakes weights at /app/agents/feedback/models/highlight_yolo_v1.pt
# Only set if you mount a custom file: YOLO_HIGHLIGHT_WEIGHTS=/run/models/highlight_yolo_v1.pt
# YOLO_POSE_WEIGHTS=yolov8n-pose.pt
# YOLO_POSE_DEVICE=cpu
# POSE_PIPELINE_OUTPUT_DIR=/app/data/pose
#
# ---- RunPod GPU pose API (offload YOLO from this container) ----
# When set, pose runs on RunPod; this container only does vision + coaching feedback.
# POSE_API_BASE_URL=https://xxxxx-5060.proxy.runpod.net
# POSE_API_KEY=
# POSE_API_POLL_TIMEOUT_SECONDS=10800
# POSE_API_POLL_INTERVAL_SECONDS=3
# POSE_API_HTTP_TIMEOUT_SECONDS=300
#
# ---- Highlight pipeline (default; no pose) ----
# YOLO detects red-circle player, writes wide field frames + player bbox crops per event.
# VIDEO_HIGHLIGHT_DETECTOR=yolo
# Agent Lab uploads send highlight_detector=openai (OpenAI picks moments; YOLO is skipped).
# VIDEO_OPENAI_PROBE_MAX_FRAMES=48
# VIDEO_OPENAI_MAX_MOMENTS=10
# VIDEO_OPENAI_WINDOW_PAD_SEC=2
# VIDEO_OPENAI_MOMENT_MODEL=gpt-4.1-mini
# VIDEO_HIGHLIGHT_EVENT_WRITE_PLAYER_CROPS=true
# VIDEO_HIGHLIGHT_VISION_MAX_WIDE_FRAMES=4
# VIDEO_HIGHLIGHT_VISION_MAX_CROP_FRAMES=2
#
# ---- Coaching style ----
# FEEDBACK_INCLUDE_POSE_CONTEXT_IN_VISION=0
# FEEDBACK_SEGMENT_MEMORY_MAX_CHARS=12000
# FEEDBACK_SEGMENT_SHARED_MAX_CHARS=12000
#
# ---- Optional pose pipeline (off by default) ----
# FEEDBACK_USE_POSE_PIPELINE=false
# POSE_API_BASE_URL=...
