# Platform API + worker configuration (local `make run-api` / Docker).
# Copy to app/backendapi/.env and fill in secrets.

# ---- Database & queue ----
DATABASE_URL=postgresql+psycopg://postgres:strongpassword@localhost:5432/athlete
REDIS_URL=redis://localhost:6379/0
SYNC_QUEUE_NAME=sheet-sync
WORKSPACE_QUEUE_NAME=agent-workspace
SYNC_POLL_ENABLED=true
SYNC_POLL_TICK_SECONDS=30

# Docker local Postgres: use repo-root .env + --profile local-postgres (see Makefile run-all).
# Docker Cloud SQL: DATABASE_URL is set by compose from CLOUDSQL_* in repo-root .env — leave
# DATABASE_URL below for host-native runs only, or comment it out when using Cloud SQL Docker.
# Cloud SQL via compose: postgresql+psycopg://USER:PASS@cloud-sql-proxy:5432/DB
# Docker production: REDIS_URL=redis://redis:6379/0, DATA_DIR=/app/data

# ---- Frontend & OAuth ----
FRONTEND_BASE_URL=https://connect.athlete-focus.com,http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
SESSION_TTL_DAYS=30

# ---- Admin ----
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL_DAYS=7

# ---- OpenAI (feedback, embeddings, Agent Lab chat) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- Player memory (Firestore vectors) ----
PLAYER_MEMORY_SETTINGS_MASTER_KEY=change-me-long-random-key
PLAYER_MEMORY_VECTOR_BACKEND=firestore
GCP_PROJECT_ID=your-gcp-project-id
GCP_FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PERSONAL=player_personal_context
FIRESTORE_COLLECTION_SHARED=shared_context
PLAYER_MEMORY_EMBEDDING_MODEL=text-embedding-3-large
PLAYER_MEMORY_EMBEDDING_DIM=2048
PLAYER_MEMORY_MCP_TOKEN=

# GCP VM: leave GOOGLE_APPLICATION_CREDENTIALS unset (VM service account / ADC).
# Local dev only: GOOGLE_APPLICATION_CREDENTIALS=credentials.json
DESTINATION_GOOGLE_CREDENTIALS_FILE=credentials.json
DESTINATION_SPREADSHEET_ID=your_destination_spreadsheet_id
DESTINATION_USER_SHEET_PREFIX=user

# ---- Feedback reviews (in-process on worker; UI on API :8000) ----
# Review links use FRONTEND_BASE_URL (/review, /jobs, /share proxied via Next.js).
FEEDBACK_PUBLIC_BASE_URL=
FEEDBACK_SHARED_CONTEXT_SPREADSHEET_ID=1P3b24Wj83_N9TJt_9wvwZOwPA9_wlIsNNrIVUMacOzk
FEEDBACK_SHARED_CONTEXT_SHEET_GID=328944959
WORKSPACE_SNAPSHOT_MAX_ROWS=500

# YOLO highlight pipeline (default). Weights path inside container or host checkout.
VIDEO_HIGHLIGHT_DETECTOR=yolo
# YOLO_HIGHLIGHT_WEIGHTS=/app/app/yolo_model/artifacts/train/highlight_v1.1.0/weights/best.pt
# YOLO_POSE_DEVICE=cpu
# YOLO_POSE_WEIGHTS=yolov8n-pose.pt
# FEEDBACK_USE_POSE_PIPELINE=false
# POSE_PIPELINE_OUTPUT_DIR=/app/data/pose

# Direct OpenAI video (Admin Agent Lab checkbox)
# VIDEO_OPENAI_DIRECT_MAX_MB=25
# VIDEO_OPENAI_DIRECT_MAX_FRAMES=36

# Remote GPU pose API (optional — only if FEEDBACK_USE_POSE_PIPELINE=true)
# POSE_API_BASE_URL=https://xxxxx-5060.proxy.runpod.net
# POSE_API_KEY=

# Agent Lab GCS video uploads (optional)
# GCS_FEEDBACK_VIDEO_BUCKET=your-feedback-videos-bucket

# Sportal MySQL sync (optional)
# PLAYER_CONTEXT_DATABASE_URL=mysql+pymysql://user:pass@host/sportal

# Sync backoff
SYNC_QUOTA_BACKOFF_BASE_MINUTES=1
SYNC_QUOTA_BACKOFF_MAX_MINUTES=60

# Advanced video/YOLO tuning: app/yolo_model/docs/
