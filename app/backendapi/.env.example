# Application configuration (primary file for local `make run-api` / `make run-worker` and Docker).
# All runtime values are read from this file; docker-compose.yml does not override them.
#
# Local Postgres (host or compose dev postgres on localhost:5432):
DATABASE_URL=postgresql+psycopg://postgres:strongpassword@localhost:5432/athlete
#
# GCP VM Docker (make run-prod / docker compose up):
# REDIS_URL=redis://redis:6379/0
# FEEDBACK_AGENT_BASE_URL=http://feedback-agent:5055
# Cloud SQL via proxy profile: DATABASE_URL=postgresql+psycopg://USER:PASS@cloud-sql-proxy:5432/DB
# Cloud SQL private IP (VM in same VPC): DATABASE_URL=postgresql+psycopg://USER:PASS@10.x.x.x:5432/DB
# GCP VM: Sheets JSON only (mounted by compose). Firestore + Cloud SQL use the VM service account (ADC).
#   DESTINATION_GOOGLE_CREDENTIALS_FILE=/run/secrets/google-credentials.json
#   Do NOT set GOOGLE_APPLICATION_CREDENTIALS on the VM (Firestore uses VM ADC only).
#   VM SA needs roles/datastore.user (Firestore) — Cloud SQL uses proxy + roles/cloudsql.client on VM SA.

FRONTEND_BASE_URL=https://connect.athlete-focus.com,http://localhost:3000

# Google OAuth configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# OAuth callback on the public API path (same host as the frontend, /api prefix).
# GOOGLE_REDIRECT_URI=https://connect.athlete-focus.com/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
SESSION_TTL_DAYS=30
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL_DAYS=7
# Admin cookie (same-origin browser only). Cross-origin dev (localhost → VM IP) uses X-Admin-Session-Id header from login JSON.
# ADMIN_SESSION_COOKIE_SAMESITE=lax
# For HTTPS + frontend on a different origin: ADMIN_SESSION_COOKIE_SAMESITE=none and ADMIN_SESSION_COOKIE_SECURE=true
# FRONTEND_BASE_URL must list every allowed origin (comma-separated).
# Example: https://connect.athlete-focus.com,http://localhost:3000

# Polling worker
SYNC_POLL_ENABLED=true
SYNC_POLL_TICK_SECONDS=30
REDIS_URL=redis://localhost:6379/0
SYNC_QUEUE_NAME=sheet-sync
WORKSPACE_QUEUE_NAME=agent-workspace

# Agent workspace (destination sheet snapshots + optional Feedback Agent delegate)
# Feedback agent env template (OpenAI, DATA_DIR, etc.): app/agents/.env.example
# Run feedback agent: PYTHONPATH=app uvicorn agents.feedback.main:app --host 0.0.0.0 --port 5055
#
# Worker -> feedback-agent base URL (server-to-server, NOT user-facing).
#   - Local dev (host):                          http://127.0.0.1:5055
#   - Docker compose (same server):              http://feedback-agent:5055
#   - Feedback agent on another host:            http://feedback-internal.yourdomain.com
# FEEDBACK_AGENT_BASE_URL=http://127.0.0.1:5055
FEEDBACK_AGENT_BASE_URL=
# User-facing review/share URLs use FRONTEND_BASE_URL (https://connect.athlete-focus.com).
# GCP example: FRONTEND_BASE_URL=https://connect.athlete-focus.com,http://localhost:3000
# Optional fallback if FRONTEND_BASE_URL is unset (API :8000 origin, not the frontend).
# FEEDBACK_PUBLIC_BASE_URL=https://02jixc4mtdppn8-8000.proxy.runpod.net
FEEDBACK_PUBLIC_BASE_URL=
FEEDBACK_AGENT_HTTP_TIMEOUT_SECONDS=30
# Longer timeout for text-only coaching jobs (OpenAI only, no video pipeline)
FEEDBACK_AGENT_HTTP_TIMEOUT_SECONDS_TEXT=180
# After POST /api/reviews the feedback agent processes in a background thread; the worker polls until done.
# FEEDBACK_AGENT_REVIEW_POLL_TIMEOUT_SECONDS=10800
# FEEDBACK_AGENT_REVIEW_POLL_INTERVAL_SECONDS=2
# FEEDBACK_AGENT_POLL_DB_UPDATE_INTERVAL_SEC=10
WORKSPACE_SNAPSHOT_MAX_ROWS=500

# Player memory — GCP Firestore native vector search (two collections)
# OPENAI_API_KEY — embeddings via text-embedding-3-large
OPENAI_API_KEY=
PLAYER_MEMORY_SETTINGS_MASTER_KEY=change-me-long-random-key
PLAYER_MEMORY_VECTOR_BACKEND=firestore
GCP_PROJECT_ID=your-gcp-project-id
GCP_FIRESTORE_DATABASE=(default)
# Agent Lab video uploads — VM service account needs roles/storage.objectAdmin on this bucket.
# For private buckets, also grant roles/iam.serviceAccountTokenCreator so signed download URLs work.
# GCS_FEEDBACK_VIDEO_BUCKET=your-feedback-videos-bucket
# GCS_FEEDBACK_VIDEO_PREFIX=feedback-videos
# GCS_FEEDBACK_VIDEO_MAX_BYTES=524288000
# GCS_FEEDBACK_VIDEO_SIGNED_URL_TTL_SECONDS=604800
# Set true only if the bucket (or objects) are publicly readable:
# GCS_FEEDBACK_VIDEO_PUBLIC=false
FIRESTORE_COLLECTION_PERSONAL=player_personal_context
FIRESTORE_COLLECTION_SHARED=shared_context
# GOOGLE_APPLICATION_CREDENTIALS=  (leave unset on GCP VM; optional for local dev only)
PLAYER_MEMORY_EMBEDDING_MODEL=text-embedding-3-large
# Firestore vector search max is 2048 dims (text-embedding-3-large supports dimensions=2048).
PLAYER_MEMORY_EMBEDDING_DIM=2048
# Agent Lab RAG chat (OpenAI chat completions after Firestore retrieval)
# AGENT_LAB_CHAT_MODEL=gpt-4.1-mini
# AGENT_LAB_CHAT_TEMPERATURE=0.35
# AGENT_LAB_CHAT_MAX_TOKENS=2000
# AGENT_LAB_RAG_TOP_K_PERSONAL=16
# AGENT_LAB_RAG_TOP_K_SHARED=10
# AGENT_LAB_RAG_MAX_PERSONAL_CHUNKS=40
# AGENT_LAB_RAG_MAX_SHARED_CHUNKS=20
# External Sportal MySQL (Cloud SQL) for personal context SQL sync
# PLAYER_CONTEXT_DATABASE_URL=mysql+pymysql://user:pass@/sportal?unix_socket=/cloudsql/PROJECT:REGION:INSTANCE
# PLAYER_CONTEXT_SQL=  (defaults to bundled player_context_sql_default.sql)
# Example: https://docs.google.com/spreadsheets/d/1P3b24Wj83_N9TJt_9wvwZOwPA9_wlIsNNrIVUMacOzk/edit?gid=328944959
FEEDBACK_SHARED_CONTEXT_SPREADSHEET_ID=1P3b24Wj83_N9TJt_9wvwZOwPA9_wlIsNNrIVUMacOzk
FEEDBACK_SHARED_CONTEXT_SHEET_GID=328944959
# FEEDBACK_SHARED_CONTEXT_MAX_CHARS=14000

# Video feedback: extra frames around each detected highlight (T ± window, 1s steps). 0 = off.
# VIDEO_HIGHLIGHT_CONTEXT_WINDOW_SEC=2
# VIDEO_HIGHLIGHT_CONTEXT_MAX_FRAMES=48

# Second vision pass: tactical markdown from ±window stills per red-circle highlight (merged into main feedback prompt).
# VIDEO_HIGHLIGHT_TEXT_SUMMARY=true
# VIDEO_HIGHLIGHT_SUMMARY_MODEL=gpt-4o-mini
# VIDEO_HIGHLIGHT_SUMMARY_MAX_WINDOWS=8
# VIDEO_HIGHLIGHT_SUMMARY_MAX_IMAGES=24
# VIDEO_HIGHLIGHT_SUMMARY_MAX_IMAGES_PER_WINDOW=5
# VIDEO_HIGHLIGHT_SUMMARY_MAX_TOKENS=2500

# Circle visibility episodes (default on): timeline probe → contiguous "circle on" spans →
# analyze [t_on−pad .. t_off+pad] per episode → one marker per episode + overall synthesis.
# If no episodes are detected, falls back to sparse circled-frame + storyboard flow.
# VIDEO_CIRCLE_SEGMENT_MODE=true
# VIDEO_CIRCLE_PROBE_INTERVAL_SEC=0.25
# VIDEO_CIRCLE_CONTEXT_PAD_SEC=2
# VIDEO_CIRCLE_SEGMENT_FRAMES=12
# VIDEO_CIRCLE_SEGMENT_FRAME_WIDTH=720
# VIDEO_CIRCLE_MIN_SEGMENT_PROBES=1
# Merge any two adjacent highlight episodes whose probes are within this many seconds
# (avoids duplicate markers when a single highlight flickers off/on briefly). 0 = off.
# VIDEO_CIRCLE_MIN_GAP_SEC=3
# VIDEO_CIRCLE_MAX_SEGMENTS=40
# VIDEO_CIRCLE_OVERALL_MAX_FRAMES_FOR_STORYBOARD=48
# VIDEO_CIRCLE_SEGMENT_VISION_MODEL=gpt-4.1-mini
# VIDEO_CIRCLE_OVERALL_MODEL=gpt-4.1-mini

# Highlight overlay detector: combined red-ring (Hough on red HSV mask, robust to arrow notches)
# + white vertical pointer (Veo / athlete-focus style). Either signal turns a probe "on".
# Optional Tesseract OCR confirms the highlighted player's first/last name when available;
# install: `apt-get install tesseract-ocr` (already in agents/feedback/Dockerfile) + pip pytesseract.
# VIDEO_HIGHLIGHT_RED_RING=true
# VIDEO_HIGHLIGHT_WHITE_POINTER=true
# auto|on|off — auto enables OCR only when pytesseract + tesseract binary are both present.
# VIDEO_HIGHLIGHT_DETECTOR_OCR=auto
# Set true to REQUIRE OCR-confirmed name match for a probe to count as "on" (strict mode).
# VIDEO_HIGHLIGHT_REQUIRE_NAME_MATCH=false

# ffprobe/ffmpeg timeouts (seconds; 0 = no limit). Prevents jobs stuck "running" on bad URLs.
# VIDEO_FFPROBE_TIMEOUT_SEC=90
# VIDEO_FFPROBE_RW_TIMEOUT_US=30000000
# VIDEO_FFMPEG_RW_TIMEOUT_US=25000000
# JPEG quality for ffmpeg-extracted stills (2–5 typical)
# VIDEO_FFMPEG_JPEG_Q=3
# Optional: some CDNs reject ffmpeg default user-agent
# VIDEO_FFMPEG_USER_AGENT=Mozilla/5.0 (compatible; FeedbackAgent/1.0)

# ---- YOLO highlight-overlay detector (replaces HSV/Hough when enabled) ----
# Set to "yolo" to use the new pipeline (coarse+fine two-pass probe → hysteresis
# events → per-event JPEG frames + mp4 clip + bbox metadata). Falls back to the
# legacy HSV path automatically if weights or ultralytics are missing.
# Default: yolo (highlight bbox + player crops → tactical vision). Use hsv for legacy circle probe only.
# Agent Lab file uploads override this per job with highlight_detector=openai.
# VIDEO_HIGHLIGHT_DETECTOR=yolo
# Enlarged JPEG crops of the YOLO highlight bbox per event frame (fed to vision with wide field stills).
# VIDEO_HIGHLIGHT_EVENT_WRITE_PLAYER_CROPS=true
# Max stills per vision call per event.
# VIDEO_HIGHLIGHT_VISION_MAX_WIDE_FRAMES=4
# VIDEO_HIGHLIGHT_VISION_MAX_CROP_FRAMES=2
# Path to the trained best.pt produced by yolo_model/scripts/train.py.
# VIDEO_HIGHLIGHT_YOLO_WEIGHTS=agents/feedback/models/highlight_yolo_v1.pt
# YOLO inference knobs.
# VIDEO_HIGHLIGHT_YOLO_CONF=0.45
# VIDEO_HIGHLIGHT_YOLO_IOU=0.5
# VIDEO_HIGHLIGHT_YOLO_IMGSZ=640
# VIDEO_HIGHLIGHT_YOLO_BATCH=16
# Device passed to ultralytics ("cpu", "0", "mps"…). Defaults to CPU.
# VIDEO_HIGHLIGHT_YOLO_DEVICE=cpu

# ---- YOLO pose pipeline (optional; off by default) ----
# When false (default): YOLO finds red-circle player → crops + wide frames → tactical coaching (no keypoints).
# Set true only if you still want RunPod/local pose JSON + posture rules.
# FEEDBACK_USE_POSE_PIPELINE=false
# Docker worker has no torch — keep true so YOLO runs in feedback-agent only (set in docker-compose.yml).
# POSE_PIPELINE_REMOTE_ONLY=true
#
# ---- Remote GPU pose API (RunPod) — set on feedback-agent (app/agents/.env) ----
# When set, feedback-agent POSTs video_url to RunPod instead of running torch locally.
# RunPod (no Docker): bash scripts/run-pose-api.sh — see app/pose_api/README.md
# POSE_API_BASE_URL=https://xxxxx-5060.proxy.runpod.net
# POSE_API_KEY=
# POSE_API_POLL_TIMEOUT_SECONDS=10800
# POSE_API_POLL_INTERVAL_SECONDS=3
# POSE_API_HTTP_TIMEOUT_SECONDS=300
# Highlight detector weights for yolo_model.scripts.detect_pose_video_yolov8 (defaults search common paths).
# YOLO_HIGHLIGHT_WEIGHTS=app/yolo_model/artifacts/train/highlight_v1.1.0/weights/best.pt
# YOLO_POSE_WEIGHTS=yolov8x-pose.pt
# YOLO_POSE_DEVICE=cuda
# POSE_PIPELINE_OUTPUT_DIR=app/yolo_model/artifacts/pose
# POSE_PIPELINE_CACHE_DIR=/tmp/pose_pipeline/video_cache
# VIDEO_PROCESSING_RQ_JOB_TIMEOUT=14400
# Two-pass probe configuration (coarse then fine).
# VIDEO_HIGHLIGHT_COARSE_INTERVAL_SEC=1.0
# VIDEO_HIGHLIGHT_FINE_INTERVAL_SEC=0.2
# VIDEO_HIGHLIGHT_COARSE_CHUNK_SEC=60.0
# VIDEO_HIGHLIGHT_COARSE_MERGE_GAP_SEC=1.5
# VIDEO_HIGHLIGHT_FINE_WINDOW_PAD_SEC=1.0
# VIDEO_HIGHLIGHT_COARSE_FRAME_WIDTH=640
# VIDEO_HIGHLIGHT_FINE_FRAME_WIDTH=640
# Hysteresis + smoothing thresholds for turning per-frame detections into events.
# VIDEO_HIGHLIGHT_EVENT_CONF_ON=0.55
# VIDEO_HIGHLIGHT_EVENT_CONF_OFF=0.35
# VIDEO_HIGHLIGHT_EVENT_MIN_SEC=0.4
# VIDEO_HIGHLIGHT_EVENT_MERGE_SEC=1.5
# VIDEO_HIGHLIGHT_EVENT_MERGE_IOU=0.3
# VIDEO_HIGHLIGHT_MAX_EVENTS=25
# Padding before/after t_on/t_off when extracting per-event assets (seconds).
# VIDEO_HIGHLIGHT_EVENT_PAD_SEC=2.0
# Frames-per-second written into each event's frames/ directory.
# VIDEO_HIGHLIGHT_EVENT_FRAME_FPS=3
# VIDEO_HIGHLIGHT_EVENT_FRAME_WIDTH=960
# Toggle the optional per-event mp4 clip and annotated previews.
# VIDEO_HIGHLIGHT_EVENT_WRITE_CLIP=true
# VIDEO_HIGHLIGHT_EVENT_WRITE_ANNOTATED=true
# Keep the intermediate coarse/fine probe JPEGs (for debugging). Off by default
# to save disk.
# VIDEO_HIGHLIGHT_KEEP_PROBE_FRAMES=false
# Local video cache (skips per-seek HTTP roundtrips against CDNs).
# VIDEO_HIGHLIGHT_VIDEO_CACHE=on
# VIDEO_HIGHLIGHT_CACHE_DIR=
# VIDEO_HIGHLIGHT_CACHE_MAX_GB=10

# Example Sportal evaluation SQL (MySQL, :first_name / :last_name binds): app/services/player_context_sql_example.sql
# What you MUST set in real app/backendapi/.env:
# 1) OPENAI_API_KEY
# 2) PLAYER_MEMORY_SETTINGS_MASTER_KEY (long random secret; used to encrypt admin settings in DB)
# 3) PLAYER_MEMORY_MCP_TOKEN (if using MCP automation)
# 4) ADMIN_EMAILS and ADMIN_PASSWORD
OPENAI_API_KEY=
PLAYER_MEMORY_SETTINGS_MASTER_KEY=change-me-long-random-key
PLAYER_MEMORY_EMBEDDING_MODEL=text-embedding-3-large
# Firestore vector search max is 2048 dims (text-embedding-3-large supports dimensions=2048).
PLAYER_MEMORY_EMBEDDING_DIM=2048
# MCP / automation: Bearer token + X-User-Id header for /agents/player-memory/*
PLAYER_MEMORY_MCP_TOKEN=

SYNC_QUOTA_BACKOFF_BASE_MINUTES=1
SYNC_QUOTA_BACKOFF_MAX_MINUTES=60

# Central/system destination Google Sheet (service account based)
DESTINATION_GOOGLE_CREDENTIALS_FILE=credentials.json
DESTINATION_SPREADSHEET_ID=your_destination_spreadsheet_id
DESTINATION_USER_SHEET_PREFIX=user

# Optional legacy source mapping flow (keep only if using /workflow/run source_row payloads)
# SOURCE_FIELD_MAP={"First and Last name":"name","Team color":"color","Team Number":"jerseyNumber","Position Played":"position","Game Details - LOG IN INFO FOR THE SITE When you were subbed in or out":"gameInstructions","Link to game":"videoLink","Type of Video":"typeOfVideo","User ID":"userId","User Email":"userEmail"}
