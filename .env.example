# Repo-root environment file (optional)
#
# Docker Compose reads this file automatically as `.env` (same directory as docker-compose.yml)
# for variable substitution — e.g. ${POSTGRES_PASSWORD} inside docker-compose.yml.
#
# Copy to `.env` in the repo root:
#   cp .env.example .env
#
# Keep POSTGRES_* aligned with credentials you use in app/backendapi/.env DATABASE_URL when pointing at
# the compose Postgres service from your host (localhost:5432).
#
# Application secrets (OAuth, OpenAI, player memory, etc.) live in app/backendapi/.env — loaded by the
# API/worker with override=False so compose `environment:` entries still win inside containers.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=athlete
POSTGRES_PORT=5432

# ---- Production / same-server deploy ----------------------------------------
# Turn OFF uvicorn auto-reload (1 = dev only, 0 = multi-worker prod).
# DEV_HOT_RELOAD=0
# Number of uvicorn workers for the API container.
# WEB_CONCURRENCY=2
#
# Public URL users click for feedback share/review pages.
# Required on a real server — otherwise the feedback agent generates links
# pointing at 127.0.0.1:5055 which won't open in any user's browser.
#   - Direct (port 5055 open on the server):     http://your.server.com:5055
#   - Behind a reverse proxy on a subdomain:     https://feedback.yourdomain.com
# PUBLIC_BASE_URL=http://your.server.com:5055

# Optional: override in-cluster URLs (defaults match standard service names in docker-compose.yml)
# DATABASE_URL_DOCKER=postgresql+psycopg://postgres:strongpassword@postgres:5432/athlete
# REDIS_URL_DOCKER=redis://redis:6379/0
# Worker → feedback-agent over the docker network. Default already uses the compose service name.
# FEEDBACK_AGENT_BASE_URL_DOCKER=http://feedback-agent:5055
# DESTINATION_GOOGLE_CREDENTIALS_FILE_DOCKER=/run/secrets/google-credentials.json
