# Repo-root file for Docker Compose interpolation only (copy to .env beside docker-compose.yml).
# Application secrets live in app/backendapi/.env and app/agents/.env.

API_PORT=8000
FEEDBACK_AGENT_PORT=5055

# Google Sheets service account JSON (Sheets API only — not Firestore / Cloud SQL).
GOOGLE_CREDENTIALS_FILE_HOST=./credentials.json

# Host directory mounted into feedback-agent as /run/models (place highlight_yolo_v1.pt here).
YOLO_MODEL_WEIGHTS_DIR=./model-weights

WEB_CONCURRENCY=2

# ---- GCP VM: Cloud SQL via proxy (VM service account, not credentials.json) ----
# VM SA needs roles/cloudsql.client (e.g. athlete-agent-vm@athletefocus-agents.iam.gserviceaccount.com).
# CLOUD_SQL_CONNECTION_NAME=athletefocus-agents:us-central1:your-instance
# CLOUDSQL_USER=postgres
# CLOUDSQL_PASSWORD=url-encoded-db-password
# CLOUDSQL_DATABASE=postgres

# ---- Local dev only (docker-compose.dev.yml) ---------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=strongpassword
# POSTGRES_DB=athlete
# POSTGRES_PORT=5432
# DEV_HOT_RELOAD=1
