# Docker Compose interpolation only (copy to .env beside docker-compose.yml).
# Application secrets: app/backendapi/.env

# ---- Local Docker + local Postgres ----
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile local-postgres up -d --build
#   make run-all

# ---- Local Docker + Cloud SQL proxy (your case) ----
#   make run-dev-cloudsql
#   Set CLOUD_SQL_* below. URL-encode the password (see comment block).

API_PORT=8000
GOOGLE_CREDENTIALS_FILE_HOST=./credentials.json
WEB_CONCURRENCY=2

# YOLO (api + worker containers)
YOLO_POSE_DEVICE=cpu
YOLO_POSE_WEIGHTS=yolov8n-pose.pt
FEEDBACK_USE_POSE_PIPELINE=false
POSE_PIPELINE_REMOTE_ONLY=false

# Local dev postgres (--profile local-postgres only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=athlete
POSTGRES_PORT=5432
DEV_HOT_RELOAD=1

# ---- GCP VM production (attached service account — no gcloud login on server) ----
#   make run-prod-cloudsql
# CLOUD_SQL_CONNECTION_NAME=athletefocus-agents:us-central1:YOUR_INSTANCE
# CLOUDSQL_USER=postgres
# CLOUDSQL_DATABASE=athlete
# CLOUDSQL_PASSWORD=url-encoded-db-password
# CLOUDSQL_USE_CREDENTIALS_FILE=0

# ---- Local Mac (gcloud auth application-default login) ----
# CLOUDSQL_USE_CREDENTIALS_FILE=1
# CLOUDSQL_CREDENTIALS_FILE_HOST=/Users/YOU/.config/gcloud/application_default_credentials.json
